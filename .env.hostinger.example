# HabilitFy - Hostinger Docker Manager template
# Copy this on the VPS and fill with real production values.

APP_IMAGE=ghcr.io/guilhermedemorais-dev/habilitfy:latest
APP_PORT=5000

DOMAIN=habilitfy.com.br
BASE_URL=https://habilitfy.com.br

DB_NAME=habilitfy
DB_USER=habilitfy
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_STRONG_ROOT_PASSWORD

SESSION_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_64
SESSION_COOKIE_SAMESITE=lax

AUTH_MODE=oidc
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://habilitfy.com.br/api/auth/google/callback
GOOGLE_AUTO_REGISTER=false
OWNER_MASTER_EMAIL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_BASE_URL=https://api.abacatepay.com
ABACATEPAY_DEV_MODE=false

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HabilitFy <noreply@habilitfy.com.br>
