# =====================================================
# HabilitFy - Production Environment Template
# -----------------------------------------------------
# Copy to .env.production on the SERVER (chmod 600) or load via your
# orchestrator's secret manager. NEVER commit real credentials.
#
# Generate strong secrets locally:
#   SESSION_SECRET:  openssl rand -hex 64
#   DB_PASSWORD:     openssl rand -base64 24 | tr -d '/+='
#   DB_ROOT_PASSWORD: openssl rand -base64 24 | tr -d '/+='
# =====================================================

NODE_ENV=production
PORT=5000
HOST=0.0.0.0
BASE_URL=https://example.com
DOMAIN=example.com

# ------ Database (REQUIRED — docker-compose.yml fails fast if missing) ------
# Use the in-cluster service name `db` when running via docker-compose.yml.
DATABASE_URL=mysql://REPLACE_USER:REPLACE_PASSWORD@db:3306/REPLACE_DB
DB_HOST=db
DB_PORT=3306
DB_USER=REPLACE_USER
DB_PASSWORD=REPLACE_PASSWORD
DB_NAME=REPLACE_DB
DB_ROOT_PASSWORD=REPLACE_ROOT_PASSWORD
# Optional: enable TLS to a managed MySQL by exporting DB_SSL=true and
# providing the CA bundle path (requires app-side support).
# DB_SSL=true
# DB_SSL_CA=/run/secrets/db-ca.pem

# ------ Session & Security (REQUIRED) ------
SESSION_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_64
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# ------ Authentication ------
AUTH_MODE=oidc
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://example.com/api/auth/google/callback
GOOGLE_AUTO_REGISTER=false
GOOGLE_AUTO_REGISTER_PASSWORD=
OWNER_MASTER_EMAIL=owner@example.com

# ------ AI Services ------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# ------ Payments ------
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_BASE_URL=https://api.abacatepay.com
ABACATEPAY_DEV_MODE=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ------ Email ------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HabilitFy <noreply@example.com>"

# ------ Optional ------
REDIS_URL=redis://redis:6379

# ------ Production fix script (optional, prefer one-shot env) ------
# PROD_ACCESS_EMAIL=
# PROD_ACCESS_PASSWORD=
# PROD_ACCESS_ROLE=student
