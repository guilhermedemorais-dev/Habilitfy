# =====================================================
# HabilitFy - Production Environment Template
# Never commit real credentials to git.
# =====================================================

NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Database
DATABASE_URL=mysql://user:password@127.0.0.1:3306/habilitfy
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=user
DB_PASSWORD=change-me
DB_NAME=habilitfy

# Session & Security
SESSION_SECRET=change-me-with-strong-random-secret
SESSION_COOKIE_SECURE=true

# Authentication
AUTH_MODE=oidc
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/api/auth/google/callback
GOOGLE_AUTO_REGISTER=false

# AI Services
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# Domain & SSL
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# Optional
REDIS_URL=
DOCKER_REGISTRY=
IMAGE_TAG=latest

# Production fix script (optional)
# PROD_ACCESS_EMAIL=
# PROD_ACCESS_PASSWORD=
# PROD_ACCESS_ROLE=student
