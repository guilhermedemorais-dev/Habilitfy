# =====================================================
# HabilitFy - Environment Configuration
# Copy this file to .env and configure your values
# =====================================================

# ===================
# Server Configuration
# ===================
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# ===================
# Database (MySQL)
# ===================
DATABASE_URL=mysql://habilitfy:habilitfy_dev@localhost:3306/habilitfy

# Database credentials (used by session store and Docker)
DB_HOST=localhost
DB_PORT=3306
DB_USER=habilitfy
DB_PASSWORD=habilitfy_secret
DB_NAME=habilitfy

# ===================
# Session & Security
# ===================
SESSION_SECRET=your-super-secret-session-key-change-in-production

# ===================
# Authentication Mode
# ===================
# Options: local (development without OAuth), production (Google OAuth)
AUTH_MODE=local

# ===================
# Google OAuth 2.0
# ===================
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/api/auth/google/callback
# Auto-create student account when Google user does not exist yet
GOOGLE_AUTO_REGISTER=false
# Optional: also define a local password for Google-created accounts
# GOOGLE_AUTO_REGISTER_PASSWORD=

# ===================
# AI Services
# ===================
# OpenAI - Chat with AI feature
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude - KYC Face Recognition
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ===================
# Local Development User
# ===================
# Used when AUTH_MODE=local
LOCAL_USER_ID=local-dev-user
LOCAL_USER_EMAIL=dev@habilitfy.com
LOCAL_USER_FIRST_NAME=Developer
LOCAL_USER_LAST_NAME=Local
LOCAL_USER_ROLE=admin

# ===================
# Redis (Optional)
# ===================
REDIS_URL=redis://localhost:6379

# ===================
# Domain & SSL (Production)
# ===================
DOMAIN=localhost
ACME_EMAIL=admin@example.com

# ===================
# Docker Registry (Optional)
# ===================
DOCKER_REGISTRY=
IMAGE_TAG=latest

# ===================
# Production Fix Script (Optional)
# ===================
# PROD_ACCESS_EMAIL=
# PROD_ACCESS_PASSWORD=
# PROD_ACCESS_ROLE=student
